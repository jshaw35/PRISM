# Minimal smoke test: confirms piControl input files resolve and load, and
# that every function in the OHC and iEEI pipelines runs without erroring,
# on a few months of data. Run this before submitting the full 100-year
# jobs. See ../README.md before first use.

module load conda
conda activate /glade/work/wkamp/conda-envs/wk_MHWs

cd "$(dirname "$0")/.."
python test_pipeline_smoke.py
